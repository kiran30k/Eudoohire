# Exclude anything that reflects the developer's editor / tooling
.idea/
.vscode/

### Secrets — never commit ###
# .env (bare) contains real secrets — never commit it
.env
# .env.local may contain local overrides with real secrets
.env.local
# .env.*.local may contain real secrets
.env.*.local
*.pem
*.key

# .env.development and .env.production are allowed —
# they contain only public keys (VITE_API_BASE_URL, VITE_RAZORPAY_KEY_ID)
# and no backend secrets.
# Backend .env (if used for local dev) is ignored:
backend/.env

### Runtime ###
uploads/
