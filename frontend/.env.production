# Production: Vercel proxy forwards /api/* to Railway backend automatically.
# VITE_API_BASE_URL is left empty so api.js uses relative paths (same origin via Vercel rewrites).
# This prevents cross-site third-party cookie blocking in browsers and eliminates CORS issues.
VITE_API_BASE_URL=

# Public Razorpay key (safe to expose in frontend — this is the key_id, NOT the secret)
VITE_RAZORPAY_KEY_ID=rzp_test_38I5IEufjhiOFj
